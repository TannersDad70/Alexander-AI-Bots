# ---------------------------------------------------------------------------
# The login gate, the Help pages and the OpenRouter key form, in front of the
# app. One site block per deployment.
#
#   <app-domain>     the app itself (signed-in only, via the cookie gate)
#   /help/           the Help pages (generated by help/build-help-pages.py)
#   /save-key        writes a new OpenRouter key into that app's .env
#   /info            reports the model and key state for the Help page
#
# Authentication is the cookie gate (gate/README.md): one password, exchanged
# once for a server-signed session cookie. Set the password with
#   python3 gate/gate-set-password.py --instance mybots --name "My Brand" --password '...'
# and run the service; Caddy asks it on every request with forward_auth.
#
# Make the shared secret with: openssl rand -hex 24
# ---------------------------------------------------------------------------

{
	auto_https off
	admin off
}

:9080 {
			# the sign-in flow is reachable without a session
			handle /login* {
				reverse_proxy 127.0.0.1:9091 {
					header_up X-Instance mybots
				}
			}
			handle /logout {
				reverse_proxy 127.0.0.1:9091 {
					header_up X-Instance mybots
				}
			}
			handle {
				route {
					# every other request must carry a valid session cookie
					forward_auth 127.0.0.1:9091 {
						uri /verify
						header_up X-Instance mybots
					}
					handle /help {
				redir * /help/ 308
			}
			handle_path /help/* {
				root * /home/youruser/help-site/mybots
				file_server
			}
			handle /save-key {
				reverse_proxy 127.0.0.1:9090 {
					header_up X-Instance mybots
					header_up X-Save-Secret replace-with-the-shared-secret
				}
			}
			handle /info {
				reverse_proxy 127.0.0.1:9090 {
					header_up X-Instance mybots
					header_up X-Save-Secret replace-with-the-shared-secret
				}
			}
			handle {
				reverse_proxy 127.0.0.1:3001
			}
		}
	}
}

# The Obsidian vault pages and the graph, one path per deployment.
# No login here: the vault and graph open directly.
:9083 {
	handle /mybots/* {
		uri strip_prefix /mybots
		root * /home/youruser/var/vault-site/mybots
		file_server
	}
	handle {
		redir * /mybots/ 302
	}
}
